<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE params SYSTEM "../../libs/tgf/params.dtd">

<params name="human" type="param" mode="mw">
	
	<section name="Robots">
		<section name="index">
			
			<section name="1">
				<attstr name="name" val="Player"/>
				<attstr name="car name" val="car7-trb1"/>
				<attnum name="race number" val="20.000000"/>
				<attnum name="red" val="1.000000"/>
				<attnum name="green" val="1.000000"/>
				<attnum name="blue" val="0.500000"/>
				<attstr name="type" val="human"/>
				<!-- amateur, not rookie. simDammageFactor[] in simuv2/categories.cpp is
			     {0.0, 0.5, 0.8, 1.0, 1.0} indexed by skill level, so a rookie
			     multiplies every impact by zero and can never record damage on any
			     track. Incidents are one of the study's objective measures, so that
			     had to change.

			     amateur rather than pro because the same setting also drives
			     simSkidFactor[] = {0.40, 0.35, 0.30, 0.0, 0.0}, which enters the tyre
			     force model directly (simuv2/wheel.cpp). Damage cannot be enabled
			     without touching how the car handles; amateur is the smallest step
			     that does it, and it leaves tyre wear and penalties (pro only) off. -->
			<attstr name="skill level" val="amateur"/>
			</section>
			
		</section>
	</section>
	
</params>
