<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE params SYSTEM "../params.dtd">

<params name="Apex Study Speedway v1" type="param" mode="mw">
    <!-- The same session as apexstudy.xml on a different circuit. It exists so
         Apex can produce races that pool with the other half of this project,
         whose kit is frozen on CG Speedway number 1: 77 of its 77 stored races
         are this track. aalborg stays the default, because CG Speedway has so
         much asphalt run-off that a car measured 14 m off the track edge takes
         no damage at all, which leaves the incident count nothing to
         discriminate on. Every other condition here is deliberately identical
         to apexstudy.xml, so choosing a preset changes one thing. -->
    <section name="Header">
        <attstr name="name" val="Apex Study Speedway v1"/>
        <attstr name="description" val="Controlled Apex human telemetry session on CG Speedway number 1"/>
        <attnum name="priority" val="1"/>
        <attstr name="menu image" val="data/img/splash-practice.png"/>
        <attstr name="run image" val="data/img/splash-run-practice.png"/>
    </section>

    <section name="Tracks">
        <attnum name="maximum number" val="1"/>
        <section name="1">
            <attstr name="name" val="g-track-1"/>
            <attstr name="category" val="road"/>
        </section>
    </section>

    <section name="Races">
        <section name="1">
            <attstr name="name" val="Apex Study"/>
        </section>
    </section>

    <section name="Apex Study">
        <attnum name="laps" val="3"/>
        <attstr name="type" val="practice"/>
        <attstr name="starting order" val="drivers list"/>
        <attstr name="restart" val="no"/>
        <attstr name="display mode" val="normal"/>
        <attstr name="display results" val="yes"/>
        <attstr name="invalidate best lap on wall touch" val="yes"/>
        <attstr name="invalidate best lap on corner cutting" val="yes"/>
        <attstr name="corner cutting time penalty" val="yes"/>
        <attnum name="fuel consumption factor" val="1"/>
        <attnum name="damage factor" val="1"/>
        <!-- Unlimited: 0 disables the retirement check in simu.cpp entirely.
             Damage is one of the study's objective measures, so it has to be
             recorded, but a novice who cannot finish five laps produces no data
             at all. The count of impacts is the measurement; being put out of
             the session by them would destroy the very comparison they feed. -->
        <attnum name="maximum dammage" val="0"/>
        <attnum name="tire factor" val="1"/>

        <section name="Starting Grid">
            <attnum name="rows" val="1"/>
            <attnum name="distance to start" val="100"/>
            <attnum name="distance between columns" val="20"/>
            <attnum name="offset within a column" val="10"/>
            <attnum name="initial speed" unit="km/h" val="0"/>
            <attnum name="initial height" unit="m" val="0.2"/>
        </section>
    </section>

    <section name="Drivers">
        <attnum name="maximum number" val="1"/>
        <attstr name="focused module" val="human"/>
        <attnum name="focused idx" val="1"/>
        <section name="1">
            <attnum name="idx" val="1"/>
            <attstr name="module" val="human"/>
        </section>
    </section>
</params>
