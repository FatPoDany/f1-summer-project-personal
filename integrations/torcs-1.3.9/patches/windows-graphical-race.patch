+// Apex capture gives each session its own TORCS profile directory, so that a
+// study run cannot inherit or overwrite the participant's own settings. The
+// Linux launcher script reads the same variable.
+static bool setApexLocalDir(char* buf, const int bufsize)
+{
+	const char* requested = getenv("APEX_TORCS_LOCAL_DIR");
+	if (requested == NULL || requested[0] == '\0') {
+		return false;
+	}
+
+	snprintf(buf, bufsize, "%s", requested);
+	buf[bufsize-1] = '\0';
+	convertDelimiter(buf, bufsize);
+
+	// GfCreateDir and the rest of TORCS expect one trailing separator.
+	size_t length = strlen(buf);
+	if (length > 0 && buf[length-1] != '/' && length + 1 < (size_t)bufsize) {
+		buf[length] = '/';
+		buf[length+1] = '\0';
+	}
+
+	if (GfCreateDir(buf) != GF_DIR_CREATED) {
+		GfError("Apex local directory creation failed: %s\n", buf);
+		return false;
+	}
+
+	SetLocalDir(buf);
+	prepareLocalDir();
+	return true;
+}
+
