+static char gApexRaceConfig[1024];
+
+
+static void apexStartRace(int /* value */)
+{
+	ReInit();
+
+	/* Reached through the menus, singlePlayerMenuActivate sets this straight
+	   after ReInit (singleplayer.cpp). Reached through -R nothing had, so the
+	   calloc in ReInit left it NULL -- and finishing a race returns to the
+	   raceman menu, which wires its "Back to Main" button and the escape key to
+	   this pointer with GfuiScreenActivate as the callback (racemanmenu.cpp).
+	   Quitting from there then reached GfuiScreenActivate(NULL), which assigns
+	   the argument to GfuiScreen and dereferences it unconditionally two lines
+	   later (gui.cpp), so the process died on 0xC0000005 every time a race was
+	   driven to the end. Aborting part way through never returns to that menu,
+	   which is why only completed races crashed. ReSinglePlayerInit returns the
+	   screen it already built during TorcsEntry, which both main.cpp paths run
+	   before calling us. */
+	ReInfo->_reMenuScreen = ReSinglePlayerInit(NULL);
+
+	const char *s, *e, *m;
+
+	ReInfo->params = GfParmReadFile(gApexRaceConfig, GFPARM_RMODE_STD);
+	if (ReInfo->params == 0) {
+		GfError("Could not open file: %s\n", gApexRaceConfig);
+		exit(1);
+	}
+
+	s = GfParmGetFileName(ReInfo->params);
+	while ((m = strstr(s, "/")) != 0) {
+		s = m + 1;
+	}
+
+	e = strstr(s, PARAMEXT);
+	ReInfo->_reFilename = strndup(s, e-s+1);
+	ReInfo->_reFilename[e-s] = '\0';
+	ReInfo->_reName = GfParmGetStr(ReInfo->params, RM_SECT_HEADER, RM_ATTR_NAME, "");
+
+	ReInitResults();
+	ReStateApply((void *) RE_STATE_EVENT_INIT);
+}
+
+
+void ReRunRaceOnGUI(const char* raceconfig)
+{
+	/* Deferred into the GLUT event loop rather than run here. main.cpp calls this
+	   before glutMainLoop(), so starting the race directly ran the whole chain --
+	   ReRaceStart, the graphic module's initView, initBoard -- against a window
+	   that had never drawn a frame. cGrTrackMap's constructor bakes the minimap
+	   outline by drawing the track into the back buffer and reading it back with
+	   glReadPixels (grtrackmap.cpp), so it read an undrawn buffer and the outline
+	   came out blank while the car dots, which are drawn live every frame, still
+	   appeared. Started from the menus this always ran inside a callback, with a
+	   realised window, which is why the same machine draws the outline that way
+	   and not this one. The delay only has to outlast the loop mapping the window
+	   and drawing once; it is imperceptible to whoever is about to drive. */
+	strncpy(gApexRaceConfig, raceconfig, sizeof(gApexRaceConfig) - 1);
+	gApexRaceConfig[sizeof(gApexRaceConfig) - 1] = '\0';
+	glutTimerFunc(200, apexStartRace, 0);
+}
