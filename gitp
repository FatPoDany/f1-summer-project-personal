#!/usr/bin/env bash
set -euo pipefail

repo_root="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"

# The university workspace exposes a protected empty .git directory. Keep the
# server-side metadata separately; normal clones on other machines use .git.
if [[ -d "$repo_root/.git-personal" ]]; then
    exec git --git-dir="$repo_root/.git-personal" --work-tree="$repo_root" "$@"
fi

exec git -C "$repo_root" "$@"
